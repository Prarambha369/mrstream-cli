#!/bin/sh
# MrStream-Cli: A minimalist sports stream CLI.
# This tool is NOT affiliated with sportsonline.vc, sportssonline.click, or any content provider.

VERSION="0.1.0-alpha"
CONFIG_DIR="${HOME}/.config/mrstream"
CONFIG_FILE="${CONFIG_DIR}/sources.yaml"
EXIT_CMD="exit"

# Load core modules
[ -f "./src/core/fetcher.sh" ] && . ./src/core/fetcher.sh
[ -f "./src/core/cache.sh" ] && . ./src/core/cache.sh
[ -f "./src/plugins/sportsonline.sh" ] && . ./src/plugins/sportsonline.sh

show_help() {
    cat << EOM
MrStream-Cli v$VERSION
A minimalist sports stream CLI.

USAGE:
  mrstream [command] [options]

COMMANDS:
  search "query"  Search for events
  doctor          Check dependencies
  version         Show version string

OPTIONS:
  --refresh       Force refresh cache
    --debug         Enable resolver debug output (prints plugin_resolve diagnostics)
  --help          Show this help

⚠️ Not affiliated with any content provider.
EOM
}

check_deps() {
    for dep in curl fzf mpv grep sed; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            printf "❌ Missing dependency: %s\n" "$dep"
            return 1
        fi
    done
    return 0
}

check_consent() {
    [ -f "$CONFIG_FILE" ] || return 1
    # Section-aware YAML parsing: check both values exist within sportsonline block
    awk '/^  sportsonline:/{in_section=1} in_section && /enabled:[[:space:]]*true/{e=1} in_section && /acknowledge_non_affiliation:[[:space:]]*true/{a=1} in_section && /^[a-z]/ && !/^  sportsonline:/{in_section=0} END{if(e&&a) exit 0; exit 1}' "$CONFIG_FILE" || return 1
    return 0
}

request_consent() {
    printf "⚠️  Source 'sportsonline' requires explicit consent.\n"
    printf "Do you acknowledge that MrStream-Cli is NOT affiliated with this source\n"
    printf "and wish to enable it? (y/N): "
    read -r response
    case "$response" in
        [yY][eE][sS]|[yY])
            # Update config file using more robust replacement
            sed -i 's/enabled:[[:space:]]*false/enabled: true/' "$CONFIG_FILE"
            sed -i 's/acknowledge_non_affiliation:[[:space:]]*false/acknowledge_non_affiliation: true/' "$CONFIG_FILE"
            printf "✅ Source enabled. You can now use 'search'.\n"
            return 0
            ;;
        *)
            printf "❌ Consent denied. To use this source, you must enable it in %s\n" "$CONFIG_FILE"
            return 1
            ;;
    esac
}

init_config() {
    mkdir -p "$CONFIG_DIR"
    if [ ! -f "$CONFIG_FILE" ]; then
        cat << EOM > "$CONFIG_FILE"
sources:
  sportsonline:
    enabled: false
    acknowledge_non_affiliation: false
EOM
    fi
}

search_events() {
    query="$1"
    cache_path=$(get_cache_path "sportsonline")

    if [ "$REFRESH" = "true" ] || ! is_cache_valid "$cache_path"; then
        init_cache
        printf "Fetching fresh schedule..." >&2

        # Run fetch in background and show a simple spinner while it runs
        ( plugin_fetch > "$cache_path" 2>/dev/null ) &
        fetch_pid=$!

        pos=0
        spinner="-\\|/"
        # Loop until fetch completes
        while kill -0 "$fetch_pid" 2>/dev/null; do
            pos=$(( (pos + 1) % 4 ))
            char=$(printf "%s" "$spinner" | cut -c $((pos + 1)))
            printf "\rFetching fresh schedule... %s" "$char" >&2
            sleep 0.2
        done

        # Wait for background process to get its exit status
        if ! wait "$fetch_pid"; then
            printf "\n❌ Fetch failed.\n" >&2
            return 1
        fi

        printf "\r✅ Fetched schedule.          \n" >&2
    fi

    events=$(cat "$cache_path" | plugin_parse)

    if [ -n "$query" ]; then
        results=$(printf "%s" "$events" | grep -i "$query")
    else
        results="$events"
    fi

    if [ -z "$results" ]; then
        printf "No events found.\n"
        return 1
    fi

    # Check if fzf is available for selection
    if command -v fzf >/dev/null 2>&1; then
        selected=$(printf "%s" "$results" | fzf --ansi --prompt="Select Event > " --delimiter='\|' --with-nth=1,2,3)
    else
        printf "fzf not found. Please install fzf or provide a specific query.\n"
        printf "%s\n" "$results"
        return 1
    fi

    if [ -n "$selected" ]; then
        url=$(printf "%s" "$selected" | cut -d'|' -f4)
        title=$(printf "%s" "$selected" | cut -d'|' -f2)
        printf "Resolving stream for: %s\n" "$title"
        resolve_output=$(plugin_resolve "$url")
        m3u8=$(printf "%s" "$resolve_output" | head -n1)
        refr=$(printf "%s" "$resolve_output" | tail -n1)

        if [ -n "$m3u8" ]; then
            printf "Playing: %s\n" "$m3u8"
            # Pass referrer header if different from the stream URL (ani-cli pattern)
            if [ -n "$refr" ] && [ "$refr" != "$m3u8" ]; then
                mpv --title="MrStream: $title" --referrer="$refr" --user-agent="Mozilla/5.0" "$m3u8"
            else
                mpv --title="MrStream: $title" "$m3u8"
            fi
        else
            printf "❌ Could not resolve stream URL.\n"
        fi
    fi
}

# Parse Global Flags
REFRESH="false"
DEBUG=""
while [ $# -gt 0 ]; do
    case "$1" in
        --refresh) REFRESH="true"; shift;;
        --debug) DEBUG=1; export DEBUG; shift;;
        --help) show_help; $EXIT_CMD 0;;
        search|doctor|version) break;;
        -*) printf "Unknown option: %s\n" "$1"; show_help; $EXIT_CMD 1;;
        *) break;;
    esac
done

# Main
init_config

cmds="$1"
[ -n "$cmds" ] && shift

case "$cmds" in
    search)
        if ! check_consent; then
            if ! request_consent; then
                $EXIT_CMD 1
            fi
        fi
        search_events "$1"
        ;;
    doctor)
        check_deps && printf "✅ All dependencies found.\n"
        ;;
    version)
        printf "MrStream-Cli v%s\n" "$VERSION"
        ;;
    *)
        show_help
        ;;
esac
