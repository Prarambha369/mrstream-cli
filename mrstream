#!/bin/sh
# MrStream-Cli: A minimalist sports stream CLI.
# This tool is NOT affiliated with sportsonline.vc, sportssonline.click, or any content provider.

VERSION="0.1.0-alpha"
CONFIG_DIR="${HOME}/.config/mrstream"
CONFIG_FILE="${CONFIG_DIR}/sources.yaml"
EXIT_CMD="exit"
CLI_PLAYER=""

# Load core modules
[ -f "./src/core/fetcher.sh" ] && . ./src/core/fetcher.sh
[ -f "./src/core/cache.sh" ] && . ./src/core/cache.sh
[ -f "./src/plugins/sportsonline.sh" ] && . ./src/plugins/sportsonline.sh
[ -f "./src/plugins/community.sh" ] && . ./src/plugins/community.sh

show_help() {
    cat << EOM
MrStream-Cli v$VERSION
A minimalist sports stream CLI.

USAGE:
  mrstream [command] [options]

COMMANDS:
  search "query"  Search for events
  doctor          Check dependencies
  version         Show version string

OPTIONS:
  --refresh       Force refresh cache
  --debug         Enable resolver debug output (prints plugin_resolve diagnostics)
  --player PLAYER Force specific player (mpv, vlc, cvlc, mplayer)
  --help          Show this help

SUPPORTED PLAYERS:
  mpv (default)   Modern player with HLS support
  vlc / cvlc      Universal multimedia player
  mplayer         Lightweight legacy player

ENVIRONMENT:
  Set MRSTREAM_PLAYER=vlc to use VLC by default
  Set DEBUG=1 before running for debug output

⚠️ Not affiliated with any content provider.
EOM
}

check_deps() {
    for dep in curl fzf grep sed; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            printf "❌ Missing dependency: %s\n" "$dep"
            return 1
        fi
    done

    # Check for at least one video player
    if ! command -v mpv >/dev/null 2>&1 && \
       ! command -v vlc >/dev/null 2>&1 && \
       ! command -v cvlc >/dev/null 2>&1 && \
       ! command -v mplayer >/dev/null 2>&1; then
        printf "❌ No video player found (need mpv, vlc/cvlc, or mplayer)\n"
        return 1
    fi
    return 0
}

# Find available player
find_player() {
    for player in mpv vlc mplayer cvlc; do
        if command -v "$player" >/dev/null 2>&1; then
            printf "%s" "$player"
            return 0
        fi
    done
    return 1
}

choose_player() {
    if [ -n "$CLI_PLAYER" ]; then
        printf "%s" "$CLI_PLAYER"
        return 0
    fi

    if [ -n "$MRSTREAM_PLAYER" ]; then
        printf "%s" "$MRSTREAM_PLAYER"
        return 0
    fi

    return 1
}

play_with_mpv() {
    title="$1"
    m3u8="$2"
    refr="$3"

    if [ -n "$refr" ] && [ "$refr" != "$m3u8" ]; then
        mpv --title="MrStream: $title" \
            --no-ytdl \
            --http-header-fields="User-Agent: Mozilla/5.0 (X11; Linux x86_64),Referer: $refr" \
            "$m3u8" 2>/dev/null && return 0

        mpv --title="MrStream: $title" \
            --no-ytdl \
            --user-agent="Mozilla/5.0 (X11; Linux x86_64)" \
            --referrer="$refr" \
            "$m3u8" 2>/dev/null && return 0
    fi

    mpv --title="MrStream: $title" --no-ytdl "$m3u8" 2>/dev/null
}

play_with_vlc() {
    player_cmd="$1"
    title="$2"
    m3u8="$3"
    refr="$4"

    if [ -n "$refr" ] && [ "$refr" != "$m3u8" ]; then
        "$player_cmd" --quiet --play-and-exit \
            --meta-title="MrStream: $title" \
            --http-user-agent="Mozilla/5.0 (X11; Linux x86_64)" \
            --http-referrer="$refr" \
            "$m3u8" 2>/dev/null && return 0
    fi

    "$player_cmd" --quiet --play-and-exit --meta-title="MrStream: $title" "$m3u8" 2>/dev/null
}

play_with_mplayer() {
    m3u8="$1"
    mplayer "$m3u8" 2>/dev/null
}

play_stream_with_player() {
    player="$1"
    title="$2"
    m3u8="$3"
    refr="$4"

    case "$player" in
        mpv)
            play_with_mpv "$title" "$m3u8" "$refr"
            ;;
        vlc|cvlc)
            play_with_vlc "$player" "$title" "$m3u8" "$refr"
            ;;
        mplayer)
            play_with_mplayer "$m3u8"
            ;;
        *)
            return 1
            ;;
    esac
}

check_consent() {
    [ -f "$CONFIG_FILE" ] || return 1
    # Section-aware YAML parsing: check both values exist within sportsonline block
    awk '/^  sportsonline:/{in_section=1} in_section && /enabled:[[:space:]]*true/{e=1} in_section && /acknowledge_non_affiliation:[[:space:]]*true/{a=1} in_section && /^[a-z]/ && !/^  sportsonline:/{in_section=0} END{if(e&&a) exit 0; exit 1}' "$CONFIG_FILE" || return 1
    return 0
}

request_consent() {
    printf "⚠️  Source 'sportsonline' requires explicit consent.\n"
    printf "Do you acknowledge that MrStream-Cli is NOT affiliated with this source\n"
    printf "and wish to enable it? (y/N): "
    read -r response
    case "$response" in
        [yY][eE][sS]|[yY])
            # Update config file using more robust replacement
            sed -i 's/enabled:[[:space:]]*false/enabled: true/' "$CONFIG_FILE"
            sed -i 's/acknowledge_non_affiliation:[[:space:]]*false/acknowledge_non_affiliation: true/' "$CONFIG_FILE"
            printf "✅ Source enabled. You can now use 'search'.\n"
            return 0
            ;;
        *)
            printf "❌ Consent denied. To use this source, you must enable it in %s\n" "$CONFIG_FILE"
            return 1
            ;;
    esac
}

init_config() {
    mkdir -p "$CONFIG_DIR"
    if [ ! -f "$CONFIG_FILE" ]; then
        cat << EOM > "$CONFIG_FILE"
sources:
  sportsonline:
    enabled: false
    acknowledge_non_affiliation: false
EOM
    fi
}

search_events() {
    query="$1"
    cache_path=$(get_cache_path "sportsonline")

    if [ "$REFRESH" = "true" ] || ! is_cache_valid "$cache_path"; then
        init_cache
        printf "Fetching fresh schedule..." >&2

        # Run fetch in background and show a simple spinner while it runs
        ( plugin_fetch > "$cache_path" 2>/dev/null ) &
        fetch_pid=$!

        pos=0
        spinner="-\\|/"
        # Loop until fetch completes
        while kill -0 "$fetch_pid" 2>/dev/null; do
            pos=$(( (pos + 1) % 4 ))
            char=$(printf "%s" "$spinner" | cut -c $((pos + 1)))
            printf "\rFetching fresh schedule... %s" "$char" >&2
            sleep 0.2
        done

        # Wait for background process to get its exit status
        if ! wait "$fetch_pid"; then
            printf "\n❌ Fetch failed.\n" >&2
            return 1
        fi

        printf "\r✅ Fetched schedule.          \n" >&2
    fi

    events=$(cat "$cache_path" | plugin_parse)

    if [ -n "$query" ]; then
        results=$(printf "%s" "$events" | grep -i "$query")
    else
        results="$events"
    fi

    if [ -z "$results" ]; then
        printf "No events found.\n"
        return 1
    fi

    # Check if fzf is available for selection
    if command -v fzf >/dev/null 2>&1; then
        selected=$(printf "%s" "$results" | fzf --ansi --prompt="Select Event > " --delimiter='\|' --with-nth=1,2,3)
    else
        printf "fzf not found. Please install fzf or provide a specific query.\n"
        printf "%s\n" "$results"
        return 1
    fi

    if [ -n "$selected" ]; then
        url=$(printf "%s" "$selected" | cut -d'|' -f4)
        title=$(printf "%s" "$selected" | cut -d'|' -f2)
        printf "Resolving stream for: %s\n" "$title"
        resolve_output=$(plugin_resolve "$url" 2>/dev/null)
        m3u8=$(printf "%s\n" "$resolve_output" | sed -n '1p')
        refr=$(printf "%s\n" "$resolve_output" | sed -n '2p')

        if [ -n "$m3u8" ]; then
            printf "Playing: %s\n" "$m3u8"
            preferred_player=$(choose_player)

            if [ -n "$preferred_player" ]; then
                [ -n "$DEBUG" ] && printf "DEBUG: using preferred player: %s\n" "$preferred_player" >&2
                [ -n "$DEBUG" ] && printf "DEBUG: m3u8 URL: %s\n" "$m3u8" >&2
                [ -n "$DEBUG" ] && printf "DEBUG: referrer: %s\n" "$refr" >&2

                if play_stream_with_player "$preferred_player" "$title" "$m3u8" "$refr"; then
                    return 0
                fi

                printf "❌ Direct playback failed with %s.\n" "$preferred_player"
                printf "ℹ️  This stream appears to be protected.\n"
                printf "Stream URL: %s\n" "$m3u8"
                [ -n "$refr" ] && printf "Referrer: %s\n" "$refr"
                [ -n "$refr" ] && printf "Try opening the referrer in a browser:\n%s\n" "$refr"
                return 1
            fi

            for player in mpv vlc mplayer cvlc; do
                command -v "$player" >/dev/null 2>&1 || continue
                [ -n "$DEBUG" ] && printf "DEBUG: attempting %s playback\n" "$player" >&2
                [ -n "$DEBUG" ] && printf "DEBUG: m3u8 URL: %s\n" "$m3u8" >&2
                [ -n "$DEBUG" ] && printf "DEBUG: referrer: %s\n" "$refr" >&2

                if play_stream_with_player "$player" "$title" "$m3u8" "$refr"; then
                    return 0
                fi
            done

            printf "❌ Direct playback failed.\n"
            printf "ℹ️  This stream appears to be protected or rejected by the player.\n"
            printf "Stream URL: %s\n" "$m3u8"
            [ -n "$refr" ] && printf "Referrer: %s\n" "$refr"
            [ -n "$refr" ] && printf "Try opening the referrer in a browser:\n%s\n" "$refr"
            return 1
        else
            printf "❌ Could not resolve stream URL.\n"
            return 1
        fi
    fi
}

# Parse Global Flags
REFRESH="false"
DEBUG=""
while [ $# -gt 0 ]; do
    case "$1" in
        --refresh) REFRESH="true"; shift;;
        --debug) DEBUG=1; export DEBUG; shift;;
        --player)
            shift
            [ $# -gt 0 ] || { printf "Missing player after --player\n"; show_help; $EXIT_CMD 1; }
            CLI_PLAYER="$1"
            shift
            ;;
        --help) show_help; $EXIT_CMD 0;;
        search|doctor|version) break;;
        -*) printf "Unknown option: %s\n" "$1"; show_help; $EXIT_CMD 1;;
        *) break;;
    esac
done

# Main
init_config

cmds="$1"
[ -n "$cmds" ] && shift

case "$cmds" in
    search)
        if ! check_consent; then
            if ! request_consent; then
                $EXIT_CMD 1
            fi
        fi
        search_events "$1"
        ;;
    doctor)
        check_deps && printf "✅ All dependencies found.\n"
        ;;
    version)
        printf "MrStream-Cli v%s\n" "$VERSION"
        ;;
    *)
        show_help
        ;;
esac
